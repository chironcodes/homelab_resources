# Linux username on the Docker host (used for volume paths)
USER=ubuntu
# Host timezone
TZ=America/Sao_Paulo
# Conductor hostname — must be resolvable on your network by worker servers
# Add to your local DNS, Tailscale, or /etc/hosts on each worker
XYOPS_HOSTNAME=xyops.internal.example.com
# Secret key for encryption/authentication — use a long random string in production
# Generate with: openssl rand -hex 32
XYOPS_SECRET_KEY=changeme
